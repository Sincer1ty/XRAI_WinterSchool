# backend/.env 로 복사해서 사용합니다. 실제 키가 들어간 .env 는 커밋하지 않습니다.
# mock: API 키 없이 규칙 기반 분석 / openai: OpenAI 호환 API 호출
ANALYZER_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 모델은 팀 확정 필요 (아래는 config.py 기본값)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
MAX_SCRIPT_CHARS=20000
MAX_PARTS=10
