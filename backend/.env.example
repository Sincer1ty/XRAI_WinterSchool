# backend/.env 로 복사해서 사용합니다. 실제 키가 들어간 .env 는 커밋하지 않습니다.
# gemini: Gemini API 직접 연결 / mock: 키 없이 규칙 기반 분석
ANALYZER_PROVIDER=gemini
# Google AI Studio에서 발급한 키를 로컬 .env에만 입력합니다.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 초기 설정 예시입니다. 팀 최종 모델은 별도로 확정합니다.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 모델은 팀 확정 필요 (아래는 config.py 기본값)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
MAX_SCRIPT_CHARS=20000
MAX_PARTS=10

# Set ANALYZER_PROVIDER=omniroute to use ONLY these values.
# Default URL assumes OmniRoute and FastAPI run on the same PC.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# Gateway API key; never commit the real key.
OMNIROUTE_API_KEY=
# Exact chat model ID from /v1/models or a configured combo name; required.
OMNIROUTE_MODEL=
# json_object sends response_format; prompt omits it. Both require valid parts JSON.
OMNIROUTE_JSON_MODE=json_object
OMNIROUTE_TIMEOUT_SECONDS=45
